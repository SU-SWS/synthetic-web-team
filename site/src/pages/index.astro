---
import Base from '../layouts/Base.astro';
import { contractExtracted } from '../lib/footer';

const REPO = 'https://github.com/SU-SWS/synthetic-web-team';

// THE thing this page exists to deliver. Written as a prompt rather than a
// command because the audience already has an agent open, and because an agent
// can adapt to whatever the project already looks like.
const installPrompt = `Install the Stanford Web Services agent team into this project.

Get the files from ${REPO} and copy in:

- AGENTS.md to the repository root
- standards/ to the repository root
- skills/ into BOTH .agents/skills/ and .claude/skills/
  (two copies on purpose: no single path is read by every editor, and there is
  no compiler)
- a CLAUDE.md containing exactly one line: @AGENTS.md

Then read AGENTS.md and tell me, in one line each, the non-negotiables you found.
Do not change any of my existing code.`;

const shellAlternative = `git clone --depth 1 ${REPO} /tmp/swt
cp -r /tmp/swt/AGENTS.md /tmp/swt/standards .
mkdir -p .agents .claude
cp -r /tmp/swt/skills .agents/skills
cp -r /tmp/swt/skills .claude/skills
echo '@AGENTS.md' > CLAUDE.md`;

const editors = [
  ['Claude Code', '.claude/skills'],
  ['VS Code + Copilot', '.claude/skills'],
  ['Cursor', '.agents/skills'],
  ['Codex CLI', '.agents/skills'],
  ['Gemini CLI', '.agents/skills'],
  ['Antigravity', '.agents/skills'],
  ['Zed', '.agents/skills'],
  ['Cline', 'either'],
];

const decisions = [
  {
    h: 'Recipes, not starter templates',
    p: `We do not ship or maintain application code. A recipe says what must be true and
        delegates the boilerplate to the upstream scaffolder, so you get current versions
        and we have nothing to keep updated. A template starts rotting the day it is
        committed, and every project made from it inherits the rot.`,
  },
  {
    h: 'Install latest, pin nothing',
    p: `Recipes name no version numbers, with exactly one exception: Decanter 8 rather
        than 7, because they are architecturally different and getting it wrong fails
        silently. Standards are written as things to avoid, which age far better than
        versions to require.`,
  },
  {
    h: 'Advisory, not blocking',
    p: `Findings are a report, a pull request comment, and a score that trends. Exactly
        one thing fails a build: a committed credential, because that harm is
        irreversible. A tool that fails your build over a contrast ratio gets uninstalled
        by Friday, and then nothing is compliant.`,
  },
  {
    h: 'Push to main deploys',
    p: `Pull requests are first-class but never required, and nothing in the setup makes
        one mandatory. Plenty of campus editors work through the GitHub web interface and
        will not open a pull request to fix a typo. With a CMS, git disappears entirely.`,
  },
  {
    h: 'Prior art is step zero',
    p: `SWS has built a lot of sites and most problems are already solved. The agent
        checks existing work before inventing anything, under a rule whose third clause
        is that prior art cannot tell you why a choice was made or where the team is
        going. Both need a person.`,
  },
];

const included = [
  ['8 role skills', 'strategist, information architect, content designer, UX, front end, accessibility, discoverability, delivery'],
  ['11 honest stubs', 'identity, security ops, compliance, QA, back end, API, infrastructure, architecture, research'],
  ['6 shared skills', 'onboarding, prior art, Decanter, compliance checks, deployment, and how to diverge on purpose'],
  ['2 recipes', 'astro-static for GitHub Pages, next-netlify for Next with CSP and security headers'],
  ['The sws CLI', '63 machine-checkable criteria across 12 check modules, with a report that tells you what it could not check'],
  ['Stanford standards', 'MinSec, MinWeb, accessibility, privacy, brand, and which office to escalate to'],
];
---

<Base
  title="Synthetic Web Team | Stanford Web Services"
  description="A portable agent team that reproduces Stanford Web Services practice inside whichever AI coding tool you already use. Compliant Stanford websites by default."
>
  <!-- Hero -->
  <div class="bg-foggy-light">
    <div class="mx-auto max-w-[144rem] px-20 py-50 md:px-30 md:py-76">
      <p class="mb-10 font-semibold uppercase tracking-widest text-16 text-digital-red">
        Stanford Web Services
      </p>
      <h1 class="type-5 mb-20 max-w-[24ch] font-serif leading-tight">Synthetic Web Team</h1>
      <p class="mb-0 max-w-[60ch] text-21 text-black-80 md:text-24">
        A portable agent team that reproduces Stanford Web Services practice inside whichever
        AI coding tool you already use. Everything we ship is Markdown, YAML, and a small
        CLI. <strong class="font-semibold">No application code, no starter templates, no design system fork.</strong>
      </p>
    </div>
  </div>

  <!-- The install prompt: the reason this page exists -->
  <section aria-labelledby="install" class="mx-auto max-w-[144rem] px-20 py-50 md:px-30">
    <h2 id="install" class="type-3 mb-10 font-serif">Install it</h2>
    <p class="mb-24 max-w-[62ch] text-19 text-black-80">
      Open your AI coding tool in the project you want to work on, then paste this in.
    </p>

    <div class="relative rounded-none border-2 border-black-20 bg-black-10">
      <div class="flex items-center justify-between gap-16 border-b border-black-20 px-16 py-10">
        <span class="text-14 font-semibold uppercase tracking-wide text-black-70"
          >Prompt to copy</span
        >
        <button
          type="button"
          id="copy-prompt"
          data-target="install-prompt"
          class="button cursor-pointer border-0 px-16 py-8 text-16"
        >
          Copy prompt
        </button>
      </div>
      <pre
        id="install-prompt"
        class="m-0 overflow-x-auto p-16 text-16 leading-relaxed whitespace-pre-wrap font-mono">{installPrompt}</pre>
    </div>
    <p id="copy-status" role="status" aria-live="polite" class="mt-8 mb-0 text-16 text-black-70"></p>

    <details class="mt-30 border-l-4 border-black-20 pl-20">
      <summary class="cursor-pointer text-19 font-semibold">
        Prefer a shell command?
      </summary>
      <p class="mt-12 mb-12 max-w-[62ch] text-17 text-black-80">
        Same result, no agent involved. The prompt is usually better because the agent can
        adapt to what your project already looks like, and it reads the contract afterwards.
      </p>
      <pre
        class="overflow-x-auto border-2 border-black-20 bg-black-10 p-16 text-16 font-mono">{shellAlternative}</pre>
    </details>

    <h3 class="type-1 mt-40 mb-12 font-serif">Why two skill directories?</h3>
    <p class="mb-16 max-w-[62ch] text-17 text-black-80">
      Because no single path is read by every editor, and we deliberately have no compiler
      to translate between formats. Two copies is the floor, not a design flaw. If you only
      use one editor, delete the other directory.
    </p>
    <ul class="grid list-none grid-cols-1 gap-x-30 gap-y-4 p-0 text-17 sm:grid-cols-2">
      {
        editors.map(([name, path]) => (
          <li class="flex justify-between gap-16 border-b border-black-10 py-6">
            <span>{name}</span>
            <code class="text-16 text-black-70">{path}</code>
          </li>
        ))
      }
    </ul>
  </section>

  <!-- What it is -->
  <section aria-labelledby="what" class="bg-foggy-light">
    <div class="mx-auto max-w-[144rem] px-20 py-50 md:px-30">
      <h2 id="what" class="type-3 mb-16 font-serif">What this is</h2>
      <div class="max-w-[68ch] space-y-16 text-19 text-black-80">
        <p class="mb-0">
          Open a project and your agent has the working knowledge of a full SWS web team:
          strategy, information architecture, content design, UX, front end, accessibility,
          discoverability, and delivery. The output is a Stanford site that is compliant by
          default and that somebody can still maintain in three years.
        </p>
        <p class="mb-0">
          <strong class="font-semibold">What it replaces, and what it does not.</strong> SWS
          already has a working answer to reusing what we built: copy the last client's
          repository. That is fast, it carries genuinely working code, and it preserves a
          hundred decisions no document captured. What it cannot do is tell you what has
          moved since. A fork made eighteen months ago silently inherits that era's Decanter,
          that era's accessibility target, and that era's dependencies. So the goal is not to
          stop copy-forking. It is to keep the reuse and add a way to know what changed.
        </p>
      </div>
    </div>
  </section>

  <!-- Philosophy -->
  <section aria-labelledby="philosophy" class="mx-auto max-w-[144rem] px-20 py-50 md:px-30">
    <h2 id="philosophy" class="type-3 mb-8 font-serif">Five decisions that surprise people</h2>
    <p class="mb-30 max-w-[62ch] text-19 text-black-80">
      These are the ones that get argued about. The argument goes better when the reasoning
      is written down.
    </p>
    <ol class="grid list-none grid-cols-1 gap-30 p-0 md:grid-cols-2">
      {
        decisions.map((d, i) => (
          <li class="border-t-4 border-cardinal-red pt-16">
            <h3 class="type-0 mb-8 font-serif">
              <span class="mr-8 text-black-50" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
              {d.h}
            </h3>
            <p class="mb-0 text-17 text-black-80">{d.p}</p>
          </li>
        ))
      }
    </ol>
  </section>

  <!-- What's included -->
  <section aria-labelledby="included" class="bg-foggy-light">
    <div class="mx-auto max-w-[144rem] px-20 py-50 md:px-30">
      <h2 id="included" class="type-3 mb-24 font-serif">What is included</h2>
      <dl class="m-0 grid grid-cols-1 gap-x-40 gap-y-20 md:grid-cols-2">
        {
          included.map(([term, def]) => (
            <div class="border-l-4 border-digital-red pl-16">
              <dt class="text-19 font-semibold">{term}</dt>
              <dd class="m-0 text-17 text-black-80">{def}</dd>
            </div>
          ))
        }
      </dl>
    </div>
  </section>

  <!-- Compliance -->
  <section aria-labelledby="compliance" class="mx-auto max-w-[144rem] px-20 py-50 md:px-30">
    <h2 id="compliance" class="type-3 mb-16 font-serif">Compliance, concretely</h2>
    <p class="mb-20 max-w-[64ch] text-19 text-black-80">
      Generated sites are built against Stanford's actual requirements rather than a generic
      checklist.
    </p>
    <ul class="mb-24 max-w-[68ch] list-disc space-y-8 pl-24 text-17 text-black-80">
      <li>
        <strong class="font-semibold">WCAG 2.1 AA</strong>, with an honest statement that
        automation catches roughly 30 percent of issues per guidance from the Office of
        Digital Accessibility. A passing run is a floor, not a conformance claim.
      </li>
      <li>
        <strong class="font-semibold">Global Footer and Identity Bar</strong> exactly as the
        Identity Guide requires, from a contract extracted from the upstream component.
      </li>
      <li>
        <strong class="font-semibold">MinWeb:</strong> named business owner and technical
        administrator, MFA on admin logins, HTTPS, no keys in Git, subdomain approved by
        University Communications.
      </li>
      <li><strong class="font-semibold">MinSec</strong>, which applies to low-risk static sites too.</li>
      <li>
        <strong class="font-semibold">Siteimprove</strong> registration, which is required.
        Google Analytics is not.
      </li>
      <li><strong class="font-semibold">No cookie banner</strong>, because none is required at Stanford.</li>
    </ul>
    <p class="mb-0 max-w-[64ch] text-17 text-black-80">
      For anything with legal, policy, or procurement weight, this project names the
      responsible university office and the specific door to use rather than recommending a
      product. It will not grant an exception, approve a subdomain, sign off a launch, or
      interpret policy on the university's behalf.
    </p>
  </section>

  <!-- Audience, including the honest redirect -->
  <section aria-labelledby="who" class="bg-cardinal-red text-white">
    <div class="mx-auto max-w-[144rem] px-20 py-50 md:px-30">
      <h2 id="who" class="type-3 mb-24 font-serif">Who this is for</h2>
      <div class="grid grid-cols-1 gap-30 md:grid-cols-3">
        <div>
          <h3 class="type-0 mb-8 font-serif">SWS staff</h3>
          <p class="mb-0 text-17">
            The primary audience. This encodes how we already work, including the parts that
            live only in people's heads.
          </p>
        </div>
        <div>
          <h3 class="type-0 mb-8 font-serif">Stanford units</h3>
          <p class="mb-0 text-17">
            If you have no web developer, consider
            <a
              href="https://uit.stanford.edu/service/stanfordsites"
              class="text-white underline hover:no-underline">Stanford Sites</a
            > first. It is free and already compliant. This is for when Stanford Sites cannot
            do the job.
          </p>
        </div>
        <div>
          <h3 class="type-0 mb-8 font-serif">Other universities</h3>
          <p class="mb-0 text-17">
            Welcome. Only the policy and fragment directories are Stanford-specific. Swap
            those and the rest works.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Status, honestly -->
  <section aria-labelledby="status" class="mx-auto max-w-[144rem] px-20 py-50 md:px-30">
    <h2 id="status" class="type-3 mb-16 font-serif">Status</h2>
    <p class="mb-20 max-w-[64ch] text-19 text-black-80">
      Early. The standards, skills, recipes, and CLI work. The install wizard works. The
      recipe canary, which is what makes “install latest” safe rather than reckless, is not
      built yet.
    </p>
    <p class="mb-0 max-w-[64ch] text-17 text-black-70">
      This page is itself generated by the <code>astro-static</code> recipe, styled with
      Decanter 8, and its Global Footer is generated from the same contract every Stanford
      site is checked against, extracted {contractExtracted}. It passes the same checks it
      asks of you.
    </p>
    <p class="mt-24 mb-0">
      <a href={REPO} class="button inline-block px-24 py-12 text-19 no-underline"
        >Read the source on GitHub</a
      >
    </p>
  </section>

  <script>
    // Progressive enhancement only. Without JS the prompt is still selectable
    // text in a <pre>, which is the whole point of putting it there.
    const btn = document.getElementById('copy-prompt');
    const status = document.getElementById('copy-status');
    btn?.addEventListener('click', async () => {
      const target = document.getElementById(btn.dataset.target ?? '');
      if (!target || !status) return;
      try {
        await navigator.clipboard.writeText(target.textContent ?? '');
        status.textContent = 'Copied. Paste it into your AI coding tool.';
      } catch {
        status.textContent = 'Could not copy automatically. Select the text above and copy it.';
      }
    });
  </script>
</Base>
