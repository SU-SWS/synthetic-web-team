---
import Base from '../layouts/Base.astro';
import { contractExtracted } from '../lib/footer';

const REPO = 'https://github.com/SU-SWS/synthetic-web-team';

const installPrompt = `Install the Stanford Web Services agent team into this project.

Get the files from ${REPO} and copy in:

- AGENTS.md to the repository root
- standards/ to the repository root
- skills/ into BOTH .agents/skills/ and .claude/skills/
- a CLAUDE.md containing exactly one line: @AGENTS.md

Then read AGENTS.md and tell me, in one line each, the non-negotiables you found.
Do not change any of my existing code.`;

const shellAlternative = `git clone --depth 1 ${REPO} /tmp/swt
cp -r /tmp/swt/AGENTS.md /tmp/swt/standards .
mkdir -p .agents .claude
cp -r /tmp/swt/skills .agents/skills
cp -r /tmp/swt/skills .claude/skills
echo '@AGENTS.md' > CLAUDE.md`;

const benefits = [
  {
    h: 'Ship in hours, not weeks',
    p: 'Go from empty repo to live Stanford site with full compliance in a single session. No manual compliance work. No technical debt.',
  },
  {
    h: 'Works with your AI tool',
    p: 'Claude Code, Cursor, VS Code, Copilot, Zed, or any agent you already use. No new tools to learn or install.',
  },
  {
    h: 'Stanford-compliant by default',
    p: 'Accessibility, security, brand, privacy all built in. Passes 90+ automated compliance checks. WCAG 2.1 AA ready.',
  },
  {
    h: 'Maintainable in three years',
    p: 'No bloat. No starter template rot. No framework lock-in. Just clean, understandable code.',
  },
];
---

<Base
  title="Synthetic Web Team | Stanford Web Services"
  description="Ship Stanford-compliant websites in hours, not weeks. AI-powered, built-in compliance, works with any AI tool you use."
>
  <!-- Hero: Big, bold, benefits-focused -->
  <div class="bg-gradient-to-b from-cardinal-red via-cardinal-red to-digital-red text-white relative overflow-hidden">
    <div class="absolute inset-0 opacity-10" style="background: radial-gradient(circle at 30% 50%, white 0%, transparent 50%)"></div>
    <div class="mx-auto max-w-[144rem] px-20 py-80 md:px-30 md:py-120 relative">
      <p class="mb-20 font-semibold uppercase tracking-widest text-18 text-white/80 opacity-0 animate-[fadeIn_0.6s_ease-out_0.1s_forwards]">
        Stanford Web Services
      </p>
      <h1 class="type-6 mb-32 max-w-[28ch] font-serif leading-tight opacity-0 animate-[fadeInUp_0.8s_ease-out_0.2s_forwards]">
        Ship Stanford sites in hours
      </h1>
      <p class="mb-32 max-w-[65ch] text-28 leading-relaxed md:text-32 opacity-0 animate-[fadeIn_0.6s_ease-out_0.3s_forwards]">
        AI meets compliance. No manual work. No technical debt. Just launch.
      </p>
      <a href="#install" class="button inline-block px-32 py-16 text-20 font-semibold bg-gradient-to-r from-white to-orange-100 text-cardinal-red no-underline opacity-0 animate-[fadeIn_0.6s_ease-out_0.4s_forwards] hover:shadow-xl hover:scale-105 transition-all duration-300">
        Get started
      </a>
    </div>
  </div>

  <!-- Benefits grid: HUGE and splashy -->
  <section aria-labelledby="benefits" class="bg-white">
    <div class="mx-auto max-w-[144rem] px-20 py-80 md:px-30">
      <h2 id="benefits" class="sr-only">Why you need this</h2>
      <div class="grid grid-cols-1 gap-40 md:grid-cols-2">
        {
          benefits.map((b, i) => (
            <div class="border-l-8 border-cardinal-red pl-32 opacity-0 transition-all duration-500 hover:border-digital-red hover:pl-40 hover:-translate-y-1 group" style={`animation: fadeInUp 0.8s ease-out ${0.1 + i * 0.1}s forwards`}>
              <h3 class="type-2 mb-16 font-serif text-cardinal-red">{b.h}</h3>
              <p class="mb-0 text-22 text-black-80 leading-relaxed">{b.p}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Install: Second priority -->
  <section aria-labelledby="install" class="bg-foggy-light">
    <div class="mx-auto max-w-[144rem] px-20 py-80 md:px-30">
      <h2 id="install" class="type-3 mb-24 font-serif">Ready to build?</h2>
      <p class="mb-40 max-w-[62ch] text-22 text-black-80">
        Open your AI tool, paste the prompt below, and your Stanford site is minutes away.
      </p>

      <div class="relative rounded-none border-2 border-black-20 bg-white mb-24">
        <div class="flex items-center justify-between gap-16 border-b border-black-20 px-24 py-14">
          <span class="text-14 font-semibold uppercase tracking-wide text-black-70"
            >Copy this prompt</span
          >
          <button
            type="button"
            id="copy-prompt"
            data-target="install-prompt"
            class="button cursor-pointer border-0 px-20 py-10 text-16 bg-cardinal-red text-white hover:bg-cardinal-red/90 hover:underline hover:underline-offset-4 hover:decoration-2 focus-visible:underline focus-visible:underline-offset-4 focus-visible:decoration-2"
          >
            Copy
          </button>
        </div>
        <pre
          id="install-prompt"
          class="m-0 overflow-x-auto p-24 text-16 leading-relaxed whitespace-pre-wrap font-mono bg-black-5">{installPrompt}</pre>
      </div>
      <p id="copy-status" role="status" aria-live="polite" class="mt-8 mb-0 text-18 text-cardinal-red font-semibold"></p>

      <details class="mt-40 border-l-4 border-black-20 pl-24">
        <summary class="cursor-pointer text-20 font-semibold hover:text-cardinal-red">
          Prefer shell? Expand here
        </summary>
        <p class="mt-16 mb-16 max-w-[62ch] text-18 text-black-80">
          Same result without an agent. Paste in your terminal:
        </p>
        <pre
          class="overflow-x-auto border-2 border-black-20 bg-black-5 p-24 text-16 font-mono">{shellAlternative}</pre>
      </details>
    </div>
  </section>

  <!-- What's included: Highlights only -->
  <section aria-labelledby="what-inside" class="bg-gradient-to-r from-foggy-light to-foggy-dark">
    <div class="mx-auto max-w-[144rem] px-20 py-80 md:px-30">
      <h2 id="what-inside" class="type-2 mb-40 font-serif opacity-0 animate-[fadeInUp_0.8s_ease-out_0.2s_forwards]">Everything you need, nothing you don't</h2>
      <ul class="grid list-none grid-cols-1 gap-40 p-0 md:grid-cols-2">
        {[
          { emoji: '•', title: 'Full SWS expertise', desc: 'Strategy, UX, accessibility, security, and delivery. All baked in.' },
          { emoji: '•', title: 'Works everywhere', desc: 'Claude Code, Cursor, VS Code, Copilot, Zed, or your favorite AI tool.' },
          { emoji: '•', title: 'Stanford compliance built-in', desc: 'WCAG 2.1 AA, MinWeb, MinSec, brand, privacy. Zero manual work.' },
          { emoji: '•', title: 'No bloat or debt', desc: 'Clean, maintainable code. No starter template rot. No lock-in.' },
        ].map((item, i) => (
          <li class="flex gap-20 opacity-0 transition-all duration-300 hover:-translate-y-1 hover:pl-4" style={`animation: fadeInUp 0.8s ease-out ${0.3 + i * 0.1}s forwards`}>
            <span class="text-40 font-serif text-cardinal-red flex-shrink-0">•</span>
            <div>
              <h3 class="type-1 mb-8 font-serif">{item.title}</h3>
              <p class="mb-0 text-18 text-black-80">{item.desc}</p>
            </div>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- Who it's for -->
  <section aria-labelledby="who" class="bg-cardinal-red text-white">
    <div class="mx-auto max-w-[144rem] px-20 py-80 md:px-30">
      <h2 id="who" class="type-3 mb-40 font-serif">Who this is for</h2>
      <div class="grid grid-cols-1 gap-40 md:grid-cols-3">
        <div>
          <h3 class="type-1 mb-12 font-serif">Web teams</h3>
          <p class="mb-0 text-18">
            Multiply your output. Build in parallel. Let AI handle the compliance while you focus on content and experience.
          </p>
        </div>
        <div>
          <h3 class="type-1 mb-12 font-serif">Individual developers</h3>
          <p class="mb-0 text-18">
            No web team at your school or unit? Ship a fully compliant site solo. Your AI does the heavy lifting.
          </p>
        </div>
        <div>
          <h3 class="type-1 mb-12 font-serif">Other universities</h3>
          <p class="mb-0 text-18">
            Only Stanford-specific bits need swapping. The rest is a portable playbook for any campus.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Status/CTA -->
  <section aria-labelledby="next" class="mx-auto max-w-[144rem] px-20 py-80 md:px-30 opacity-0 animate-[fadeIn_0.8s_ease-out_0.5s_forwards]">
    <h2 id="next" class="type-3 mb-24 font-serif">Ready to launch?</h2>
    <p class="mb-40 max-w-[64ch] text-20 text-black-80">
      Scroll back to the top and paste the prompt into your AI tool. Your Stanford site builds itself.
    </p>
    <div class="flex gap-20 flex-wrap">
      <a href={REPO} class="inline-block rounded-none bg-gradient-to-r from-cardinal-red to-digital-red px-32 py-16 text-18 font-semibold text-white no-underline transition-all duration-300 hover:shadow-lg hover:scale-105 hover:from-digital-red hover:to-cardinal-red focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-cardinal-red">
        View on GitHub
      </a>
      <a href="#install" class="inline-block rounded-none border-2 border-cardinal-red bg-white px-32 py-16 text-18 font-semibold text-cardinal-red no-underline transition-all duration-300 hover:shadow-lg hover:scale-105 hover:bg-cardinal-red hover:text-white focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-cardinal-red">
        Back to install
      </a>
    </div>
  </section>

  <script>
    // Progressive enhancement only. Without JS the prompt is still selectable
    // text in a <pre>, which is the whole point of putting it there.
    const btn = document.getElementById('copy-prompt');
    const status = document.getElementById('copy-status');
    btn?.addEventListener('click', async () => {
      const target = document.getElementById(btn.dataset.target ?? '');
      if (!target || !status) return;
      try {
        await navigator.clipboard.writeText(target.textContent ?? '');
        status.textContent = 'Copied. Paste it into your AI coding tool.';
      } catch {
        status.textContent = 'Could not copy automatically. Select the text above and copy it.';
      }
    });
  </script>
</Base>
