---
import '../styles/global.css';
import { resourceLinks, policyLinks, copyrightLines } from '../lib/footer';

interface Props { title: string; description: string; }
const { title, description } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareSourceCode',
  name: 'Synthetic Web Team',
  description,
  codeRepository: 'https://github.com/SU-SWS/synthetic-web-team',
  programmingLanguage: 'JavaScript',
  license: 'https://www.gnu.org/licenses/gpl-3.0.html',
  author: {
    '@type': 'EducationalOrganization',
    name: 'Stanford Web Services, Stanford University',
    url: 'https://uit.stanford.edu/sws',
  },
};
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <link rel="sitemap" href="/synthetic-web-team/sitemap-index.xml" />
    <!-- Google Fonts, per Decanter 8: it ships no font assets. -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Source+Sans+3:ital,wght@0,300..700;1,300..700&family=Source+Serif+4:ital,opsz,wght@0,8..60,300..700;1,8..60,300..700&display=swap"
    />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

    <!--
      MOTION GUARD. Runs before first paint, so it cannot flash.
      Adds `js` to <html>; the hidden starting state in global.css applies only
      when that class is present. Two failure modes handled by one line:

        JavaScript disabled or broken   the class is never added, so nothing is
                                       ever hidden and all content is visible
        prefers-reduced-motion         handled in CSS, alongside the same rule

      This replaces a <noscript><style> override, which worked but only covered
      the first case: a script error AFTER the noscript block still left content
      hidden, because the browser had JavaScript enabled. See
      standards/patterns/motion.md.
    -->
    <script is:inline>document.documentElement.classList.add('js');</script>
  </head>

  <body class="bg-black text-white antialiased">
    <!-- The only thing permitted above the Identity Bar. -->
    <a
      href="#main-content"
      class="skiplink sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-50 focus:bg-white focus:px-16 focus:py-8 focus:text-cardinal-red focus:underline"
      >Skip to main content</a
    >

    <!--
      Stanford Identity Bar. Nothing above it but the skip link.

      EXACT, from standards/fragments/identity-bar.yml. Do not restyle it.
      `pt-5 pb-1` gives the 26px Stanford height; the previous version used
      `py-12` in a centred max-width wrapper with `font-serif text-24 md:text-27`
      and measured about 44px — visibly taller than every other Stanford site,
      which is how the error was spotted.

      `logo` is a Decanter component class carrying --font-stanford and its
      ligature settings, and it forces cardinal red on hover and focus, which is
      why `hocus:text-white` is needed to override it inside the red bar.
    -->
    <div id="su-identity" class="bg-cardinal-red px-20 pt-5 pb-1 sm:px-30 md:px-50 lg:px-30">
      <a
        class="logo inline-block text-20 leading-none text-white no-underline hocus:text-white hocus:underline"
        href="https://www.stanford.edu">Stanford University<span class="sr-only"> (link is external)</span></a
      >
    </div>

    <!--
      Site header. Below the Identity Bar, which is the only ordering rule that
      matters here: nothing may go above it except the skip link.
    -->
    <header class="sticky top-0 z-40 border-b border-black-90 bg-black/95 backdrop-blur">
      <div class="mx-auto flex max-w-[144rem] items-center gap-24 px-20 py-16 md:px-30">
        <a href="/synthetic-web-team/" class="flex items-center gap-10 no-underline">
          <span class="text-22 font-semibold text-white">Synthetic Web Team</span>
          <span
            class="rounded-sm border border-poppy-light px-8 py-2 text-12 font-semibold tracking-wide text-poppy-light"
            >EARLY</span
          >
        </a>
        <nav aria-label="Sections" class="ml-auto hidden gap-24 md:flex">
          {
            [
              ['#install', 'Install'],
              ['#verify', 'Verify'],
              ['#entrypoints', 'Entry points'],
              ['#inside', 'What is inside'],
            ].map(([href, label]) => (
              <a
                href={href}
                class="text-17 text-black-20 no-underline hover:text-white hover:underline focus-visible:text-white"
                >{label}</a
              >
            ))
          }
        </nav>
        <a
          href="https://github.com/SU-SWS/synthetic-web-team"
          class="ml-auto text-17 text-black-20 no-underline hover:text-white hover:underline md:ml-0"
          >GitHub</a
        >
      </div>
    </header>

    <main id="main-content"><slot /></main>

    <!-- Local footer. Unit links go HERE, never inside the Global Footer. -->
    <div class="border-t border-black-90 bg-black">
      <div class="mx-auto max-w-[144rem] px-20 py-30 md:px-30">
        <p class="mb-0 text-16 text-black-30">
          Built and maintained by
          <a href="https://uit.stanford.edu/sws" class="text-white underline hover:no-underline"
            >Stanford Web Services</a
          >. Source on
          <a
            href="https://github.com/SU-SWS/synthetic-web-team"
            class="text-white underline hover:no-underline">GitHub</a
          >, licensed GPL-3.0-or-later.
        </p>
      </div>
    </div>

    <!--
      Stanford Global Footer. IMMUTABLE.
      Generated from standards/fragments/global-footer.yml at build time, so it
      cannot drift from the contract every other Stanford site is checked against.
    -->
    <footer id="su-global-footer" class="bg-cardinal-red text-white">
      <div class="mx-auto max-w-[144rem] px-20 py-36 md:px-30">
        <nav aria-label="global footer menu" class="mb-20">
          <ul class="mb-16 flex list-none flex-col gap-y-8 p-0 text-16 sm:flex-row sm:gap-x-30">
            {
              resourceLinks.map((l) => (
                <li>
                  <a href={l.href} class="text-white no-underline hover:underline focus:underline"
                    set:html={l.label.replace(/&/g, '&amp;')}
                  />
                </li>
              ))
            }
          </ul>
          <ul class="flex list-none flex-col gap-y-8 p-0 text-14 sm:flex-row sm:gap-x-24">
            {
              policyLinks.map((l) => (
                <li>
                  <a
                    href={l.href}
                    title={l.title}
                    class="text-white no-underline hover:underline focus:underline">{l.label}</a
                  >
                </li>
              ))
            }
          </ul>
        </nav>
        <p class="mb-0 text-14">
          {copyrightLines.map((line) => <span class="mr-8">{line}</span>)}
        </p>
      </div>
    </footer>
  </body>
</html>
