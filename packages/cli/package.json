{
  "name": "@su-sws/sws-cli",
  "version": "0.1.0",
  "description": "Advisory compliance checks for Stanford websites.",
  "license": "GPL-3.0-or-later",
  "type": "module",
  "bin": {
    "sws": "./bin/sws.mjs"
  },
  "files": [
    "bin",
    "src"
  ],
  "dependencies": {
    "node-html-parser": "^7.0.1",
    "yaml": "^2.8.1",
    "@su-sws/standards": "^0.1.0"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "peerDependencies": {
    "@playwright/test": "*",
    "@axe-core/playwright": "*"
  },
  "peerDependenciesMeta": {
    "@playwright/test": {
      "optional": true
    },
    "@axe-core/playwright": {
      "optional": true
    }
  },
  "exports": {
    ".": "./src/checks.mjs",
    "./bin/sws.mjs": "./bin/sws.mjs",
    "./src/*": "./src/*"
  }
}
