node_modules
dist
.astro
.next

# Emitted skill copies. `skills/` is the source of truth in THIS repo.
# These two directories exist locally so that an agent working on this repo has
# the skills loaded (dogfooding). They are generated, never edited, never
# committed. Run `npm run sync-skills` to refresh them.
#
# NOTE: in a CONSUMER project the situation is different. There is no `skills/`
# source there, the wizard emits both paths, and both ARE committed, because no
# single path is read by every editor and there is no compiler. See
# docs/skill-paths.md.
.agents/skills/
.claude/skills/

# axe results, derived from a build. Regenerate with `sws a11y`; never commit.
# Committing them would let a stale pass travel with the repo, and `sws check`
# treats results older than the build as `unknown` precisely to stop that.
**/.sws/axe-results.json
**/.sws/perf-results.json

# Local score history, for `sws doctor`'s "since your last run". Per-developer,
# not shared state: the project trend lives in the Site health issue body. See
# packages/cli/src/history.mjs for why there are two.
**/.sws/score-history.json

# Tarballs from `npm run pack:all`.
.pack/

# Local prior-art index. Contains paths from the user's own disk and must never
# be committed or transmitted.
.sws/prior-art.local.yml
